---
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
}
const { title, description, canonicalPath } = Astro.props;
const siteOrigin = 'https://ai-garage.tech';
const siteRoot = '';
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={siteOrigin + siteRoot + canonicalPath}>
<link rel="icon" type="image/png" href={siteOrigin + siteRoot + '/favicon.png'}>
<meta property="og:type" content="article">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={siteOrigin + siteRoot + canonicalPath}>
<meta property="og:image" content={siteOrigin + siteRoot + '/og-image.png'}>
<meta name="twitter:card" content="summary_large_image">
<script type="text/javascript" is:inline>
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "y0aui9ba3z");
</script>
<style>
  @font-face {
    font-family: 'JetBrains Mono';
    src: local('JetBrains Mono');
    font-weight: 400 800;
  }
  @font-face {
    font-family: 'Source Serif 4';
    src: local('Source Serif 4');
    font-weight: 400 700;
  }

  :root {
    --bg: #0a0a0a;
    --surface: #121212;
    --surface-2: #1a1a1a;
    --ink: #ededed;
    --ink-soft: #9e9e9e;
    --ink-faint: #6a6a6a;
    --line: #262626;
    --accent: #3ed17f;
    --accent-dim: #1f6b41;
    --accent-soft: #0f2a1b;
    --mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    --serif: 'Source Serif 4', Georgia, serif;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: rgba(62,209,127,.28); }

  .wrap { max-width: 780px; margin: 0 auto; padding: 0 28px; }
  a { color: inherit; }

  header.site {
    position: sticky; top: 0; z-index: 50;
    background: rgba(10,10,10,.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-inner {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 0; max-width: 1100px; margin: 0 auto; padding-left: 28px; padding-right: 28px;
  }
  .logo { font-weight: 700; font-size: 14px; letter-spacing: 0.02em; }
  .logo .dot { color: var(--accent); }
  nav.main { display: flex; align-items: center; gap: 26px; }
  nav.main a { font-size: 12.5px; color: var(--ink-soft); text-decoration: none; }
  nav.main a:hover { color: var(--ink); }
  nav.main a.current { color: var(--accent); }

  main { padding: 56px 0 90px; }

  .eyebrow { font-size: 12px; color: var(--accent); margin-bottom: 14px; letter-spacing: 0.05em; text-transform: uppercase; }
  .eyebrow::before { content: '// '; opacity: .6; }

  footer.site {
    padding: 28px 0; text-align: center; font-size: 12px; color: var(--ink-faint);
    border-top: 1px solid var(--line);
  }
</style>
</head>
<body>
<header class="site">
  <div class="site-inner">
    <a class="logo" href={siteRoot + '/'} style="text-decoration:none;">ии-гараж<span class="dot">_</span></a>
    <nav class="main">
      <a href={siteRoot + '/#cases'}>кейсы</a>
      <a href={siteRoot + '/#services'}>услуги</a>
      <a href={siteRoot + '/#team'}>команда</a>
      <a href={siteRoot + '/blog/'} class="current">блог</a>
      <a href={siteRoot + '/#contact'}>контакты</a>
    </nav>
  </div>
</header>

<main class="wrap">
  <slot />
</main>

<footer class="site">
  ИИ-Гараж · ИИ-агенты, автоматизация и сайты для бизнеса
</footer>
</body>
</html>
