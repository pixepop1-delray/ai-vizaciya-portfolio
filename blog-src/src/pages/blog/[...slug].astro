---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateLabel = post.data.date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BlogLayout
  title={`${post.data.title} — ИИ-Гараж`}
  description={post.data.excerpt}
  canonicalPath={`/blog/${post.id}/`}
>
  <a class="back-link" href="/blog/">← все статьи</a>

  <div class="eyebrow">блог</div>
  <h1>{post.data.title}</h1>
  <div class="post-meta">{dateLabel}</div>

  {post.data.cover && <img class="post-cover" src={post.data.cover} alt={post.data.title} />}

  {post.data.tags.length > 0 && (
    <div class="post-tags">
      {post.data.tags.map((tag) => <span class="post-tag">{tag}</span>)}
    </div>
  )}

  <article class="post-body">
    <Content />
  </article>
</BlogLayout>

<style>
  .back-link { display: inline-block; font-size: 12.5px; color: var(--ink-soft); text-decoration: none; margin-bottom: 28px; }
  .back-link:hover { color: var(--accent); }

  h1 {
    font-family: var(--serif); font-weight: 600; font-size: clamp(26px, 4vw, 36px);
    margin: 0 0 12px; text-wrap: balance; line-height: 1.25;
  }
  .post-meta { font-size: 12px; color: var(--ink-faint); margin-bottom: 24px; }
  .post-cover { width: 100%; height: auto; border-radius: 12px; margin-bottom: 24px; display: block; }

  .post-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 32px; }
  .post-tag { font-size: 10.5px; color: var(--accent); background: var(--accent-soft); padding: 2px 8px; border-radius: 100px; }

  .post-body {
    font-size: 15px; line-height: 1.8; color: var(--ink);
  }
  .post-body :global(p) { margin: 0 0 20px; overflow-wrap: break-word; }
  .post-body :global(h2) {
    font-family: var(--serif); font-weight: 600; font-size: 22px;
    margin: 40px 0 16px;
  }
  .post-body :global(h3) {
    font-family: var(--serif); font-weight: 600; font-size: 18px;
    margin: 32px 0 14px;
  }
  .post-body :global(a) { color: var(--accent); }
  .post-body :global(img) { max-width: 100%; border-radius: 10px; margin: 24px 0; }
  .post-body :global(code) {
    font-family: var(--mono); font-size: 13px; background: var(--surface-2);
    padding: 2px 6px; border-radius: 4px;
  }
  .post-body :global(pre) {
    background: var(--surface); border: 1px solid var(--line); border-radius: 10px;
    padding: 16px; overflow-x: auto;
  }
  .post-body :global(pre code) { background: none; padding: 0; }
  .post-body :global(blockquote) {
    border-left: 2px solid var(--accent); margin: 24px 0; padding: 4px 20px;
    color: var(--ink-soft); background: var(--surface); border-radius: 0 8px 8px 0;
  }
  .post-body :global(ul), .post-body :global(ol) { padding-left: 22px; margin: 0 0 20px; }
  .post-body :global(li) { margin-bottom: 8px; }
</style>
